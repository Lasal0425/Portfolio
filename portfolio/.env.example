# Copy to .env.local and fill in. Nothing here is required for the site to
# run — every feature that needs a key degrades gracefully without one.

# Powers the ingest script (npm run ingest) and the "Ask about my work"
# assistant's live retrieval + generation. Get a free key at
# https://aistudio.google.com/apikey — no card required. Without this set,
# /api/ask serves prewritten fallback answers instead.
GEMINI_API_KEY=

# Raises the GitHub API rate limit for the live repo/activity data on the
# home page (unauthenticated requests are capped at 60/hour per IP, which
# is fine for local dev but tight once ISR is revalidating hourly in
# production). A classic token with no scopes selected is enough — this
# only reads public data. Without this set, that section falls back to a
# cached/static view instead of failing.
GITHUB_TOKEN=
